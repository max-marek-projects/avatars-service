# ---------- HTTP ----------
SERVER_PORT=8080
LOGGER_LEVEL=INFO

# ---------- PostgreSQL ----------
POSTGRES_USER=avatars
POSTGRES_PASSWORD=avatars
POSTGRES_DB=avatars
POSTGRES_PORT=5432

# ---------- S3 / MinIO ----------
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=avatars
