# ---------- HTTP ----------
SERVER_PORT=8080
LOGGER_LEVEL=INFO

# ---------- PostgreSQL ----------
POSTGRES_USER=avatars
POSTGRES_PASSWORD=avatars
POSTGRES_DB=avatars
POSTGRES_PORT=5432

# ---------- S3 / MinIO ----------
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=avatars
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- RabbitMQ ----------
RABBIT_USER=guest
RABBIT_PASSWORD=guest
RABBIT_PORT=5672
RABBIT_MGMT_PORT=15672

# ---------- Service ----------
DEFAULT_AVATAR_KEY=
MAX_FILE_SIZE=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# ---------- Observability ----------
OTEL_EXPORTER_OTLP_ENDPOINT=jaeger:4318
OTEL_SERVICE_NAME=avatars-service
OTEL_SAMPLE_RATIO=1.0