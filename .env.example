MINIO_CONSOLE_PORT=9001

# ---------- RabbitMQ ----------
RABBIT_USER=guest
RABBIT_PASSWORD=guest
RABBIT_PORT=5672
RABBIT_MGMT_PORT=15672

# ---------- Service ----------
# Set to an S3 key (already present in the bucket) to serve a placeholder.
DEFAULT_AVATAR_KEY=
